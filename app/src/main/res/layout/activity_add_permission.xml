<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:fitsSystemWindows="true"
    tools:context=".permission.Add_permission">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        >



    <androidx.appcompat.widget.Toolbar
       android:background="@color/colorPrimary"
        android:id="@+id/addPermission_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="Permission Request"
        app:titleTextColor="@color/white"
        >

    </androidx.appcompat.widget.Toolbar>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_below="@id/addPermission_toolbar"
    android:orientation="vertical"
    android:gravity="center"
    >

 <androidx.cardview.widget.CardView
     android:layout_width="match_parent"
     android:layout_height="580dp"
     android:layout_marginLeft="20dp"
     android:layout_marginRight="22dp"
     app:cardBackgroundColor="#cdd4d4"
     app:cardCornerRadius="40dp"
     android:gravity="center"

     >
     <LinearLayout
         android:layout_width="match_parent"
         android:layout_height="match_parent"
         android:orientation="vertical"
         >
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Leave Title"
        android:textSize="25sp"
        android:layout_marginTop="30dp"
        android:layout_margin="15dp"
        >
    </TextView>
    <Spinner
        android:id="@+id/Permission_title"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:background="@color/white"
        />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="From Date"
            android:textSize="20sp"
            android:layout_margin="15dp"
            android:layout_weight="1"
            >
        </TextView>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="To Date"
            android:textSize="20sp"
            android:layout_margin="15dp"
            android:layout_weight="1"
            >
        </TextView>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_marginLeft="10sp"
        android:layout_marginRight="10sp"
        >
        <androidx.cardview.widget.CardView
            android:id="@+id/from_datecard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/white"
            app:cardCornerRadius="20dp"
            android:layout_weight="1"
            android:layout_marginRight="10dp"

            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                >

                <EditText
                    android:id="@+id/from_dateEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginRight="10sp"
                    android:layout_marginLeft="10sp"
                    android:focusable="false"
                    >

                </EditText>
                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="35sp"
                    android:layout_weight="1"
                    android:src="@drawable/calendar"
                    android:layout_gravity="center"
                    android:layout_marginRight="10sp"
                    >
                </ImageView>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:id="@+id/to_datecard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/white"
            app:cardCornerRadius="20dp"
            android:layout_weight="1"

            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                >
<!--                <CalendarView-->
<!--                    android:id="@+id/to_date"-->
<!--                    android:layout_width="match_parent"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:layout_weight="1"-->
<!--                    android:visibility="gone"-->

<!--                    />-->
                <EditText
                    android:id="@+id/to_dateEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginRight="10sp"
                    android:layout_marginLeft="10sp"
                    android:focusable="false"
                    >

                </EditText>
                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="35sp"
                    android:layout_weight="1"
                    android:src="@drawable/calendar"
                    android:layout_gravity="center"
                    android:layout_marginRight="10sp"
                    >
                </ImageView>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
         <LinearLayout
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:orientation="horizontal"
             android:layout_gravity="right"
             android:gravity="end"
             android:layout_marginRight="20dp"
             >
             <TextView
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:text="Days:"
                 android:textSize="20dp"
                 >

             </TextView>
             <EditText
                 android:id="@+id/totalDays"
                 android:layout_width="100dp"
                 android:layout_height="wrap_content"

                 >


             </EditText>
         </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="From Time"
            android:textSize="20sp"
            android:layout_margin="15dp"
            android:layout_weight="1"
            >
        </TextView>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="To Time"
            android:textSize="20sp"
            android:layout_margin="15dp"
            android:layout_weight="1"
            >
        </TextView>

    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_marginLeft="10sp"
        android:layout_marginRight="10sp"
        >
        <androidx.cardview.widget.CardView
            android:id="@+id/from_timecard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/white"
            app:cardCornerRadius="20dp"
            android:layout_weight="1"
            android:layout_marginRight="10dp"

            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                >
                <EditText
                    android:id="@+id/from_timeEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginRight="10sp"
                    android:layout_marginLeft="10sp"
                    android:focusable="false"
                    >

                </EditText>
                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="35sp"
                    android:layout_weight="1"
                    android:src="@drawable/time"
                    android:layout_gravity="center"
                    android:layout_marginRight="10sp"
                    >
                </ImageView>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:id="@+id/to_timecard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/white"
            app:cardCornerRadius="20dp"
            android:layout_weight="1"

            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                >
                <!--                <CalendarView-->
                <!--                    android:id="@+id/to_date"-->
                <!--                    android:layout_width="match_parent"-->
                <!--                    android:layout_height="wrap_content"-->
                <!--                    android:layout_weight="1"-->
                <!--                    android:visibility="gone"-->

                <!--                    />-->
                <EditText
                    android:id="@+id/to_TimeEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginRight="10sp"
                    android:layout_marginLeft="10sp"
                    android:focusable="false"
                    >

                </EditText>
                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="35sp"
                    android:layout_weight="1"
                    android:src="@drawable/time"
                    android:layout_gravity="center"
                    android:layout_marginRight="10sp"
                    >
                </ImageView>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
         <LinearLayout
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:orientation="horizontal"
             android:layout_gravity="right"
             android:gravity="end"
             android:layout_marginRight="20dp"
             >
             <TextView

                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:text="Day/hr:"
                 android:textSize="20dp"
                 >

             </TextView>
             <EditText
                 android:id="@+id/totalHrs"
                 android:layout_width="100dp"
                 android:layout_height="wrap_content"
                 >


             </EditText>
         </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Descrpition"
        android:textSize="25sp"
        android:layout_margin="15dp"
        >
    </TextView>
    <EditText
        android:id="@+id/per_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="25dp"
        android:layout_marginLeft="10dp"
        android:background="@drawable/edit_text_border"
        android:height="40dp"
        android:backgroundTint="@color/white"


        >
    </EditText>
    <Button
        android:id="@+id/per_applybtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginRight="30dp"
        android:layout_marginLeft="30dp"
        android:hint="APPLY"
        android:textColorHint="@color/white"
        android:textSize="18sp"
        >


    </Button>
     </LinearLayout>
 </androidx.cardview.widget.CardView>
</LinearLayout>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>